{
  "name": "@getyoti/share-client-core",
  "version": "0.0.1-beta.2",
  "author": "Yoti LTD <tech@yoti.com> (https://www.yoti.com/developers)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getyoti/share-client.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --p ./tsconfig.build.json && vite build",
    "build:analyse": "analyze",
    "prepack": "npm run build",
    "test": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc",
    "lint-staged": "lint-staged"
  },
  "dependencies": {
    "@getyoti/share-client-types": "^0.0.1-beta.2"
  },
  "devDependencies": {
    "@getyoti/share-client-lint-config": "^0.0.1-beta.2",
    "@types/node": "20.17.46",
    "jsdom": "26.1.0",
    "lint-staged": "16.0.0",
    "typescript": "5.8.3",
    "vite": "6.4.1",
    "vite-bundle-analyzer": "0.20.2",
    "vite-plugin-dts": "4.5.3",
    "vitest": "3.1.3"
  },
  "lint-staged": {
    "*.{md,json}": "prettier --write",
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
